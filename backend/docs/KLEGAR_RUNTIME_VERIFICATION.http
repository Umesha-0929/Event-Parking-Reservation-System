@baseUrl = http://localhost:5000

# Replace these with real IDs while testing.
@eventId = 11111111-1111-1111-1111-111111111111
@organizerId = 22222222-2222-2222-2222-222222222222
@customerId = 33333333-3333-3333-3333-333333333333
@scannerId = 44444444-4444-4444-4444-444444444444

# Paste IDs returned by previous requests.
@sectionId = 55555555-5555-5555-5555-555555555555
@categoryId = 66666666-6666-6666-6666-666666666666
@seatId = 77777777-7777-7777-7777-777777777777

# Paste values returned during testing.
@holdToken = REPLACE_HOLD_TOKEN
@bookingId = 88888888-8888-8888-8888-888888888888
@ticketNo = REPLACE_TICKET_NO
@qrPayload = REPLACE_QR_PAYLOAD


### 1 - Configure organizer 2D seating layout
PUT {{baseUrl}}/api/events/{{eventId}}/seating-layout
Content-Type: application/json
X-SEVPMS-Demo-UserId: {{organizerId}}
X-SEVPMS-Demo-Role: Organizer

{
  "stageType": 4,
  "rowCount": 10,
  "columnCount": 12,
  "canvasWidth": 1200,
  "canvasHeight": 800,
  "stageX": 300,
  "stageY": 40,
  "stageWidth": 600,
  "stageHeight": 120
}


### 2 - Create Premium section
PUT {{baseUrl}}/api/events/{{eventId}}/seating-layout/sections
Content-Type: application/json
X-SEVPMS-Demo-UserId: {{organizerId}}
X-SEVPMS-Demo-Role: Organizer

{
  "id": null,
  "name": "Premium Center",
  "code": "PREM",
  "rowCount": 5,
  "columnCount": 8,
  "x": 200,
  "y": 220,
  "width": 800,
  "height": 350,
  "displayOrder": 1,
  "isAccessibleSection": false,
  "isEnabled": true
}


### 3 - Create Premium category and price
PUT {{baseUrl}}/api/events/{{eventId}}/seating-layout/categories
Content-Type: application/json
X-SEVPMS-Demo-UserId: {{organizerId}}
X-SEVPMS-Demo-Role: Organizer

{
  "id": null,
  "name": "Premium",
  "code": "PREM",
  "price": 7500,
  "displayOrder": 1,
  "isActive": true
}


### 4 - Generate seats with accessibility, unavailable seat and aisle gap
POST {{baseUrl}}/api/events/{{eventId}}/seating-layout/generate-seats
Content-Type: application/json
X-SEVPMS-Demo-UserId: {{organizerId}}
X-SEVPMS-Demo-Role: Organizer

{
  "sectionId": "{{sectionId}}",
  "seatCategoryId": "{{categoryId}}",
  "rowCount": 5,
  "columnCount": 8,
  "startingRowLabel": "A",
  "startingSeatNumber": 1,
  "startX": 250,
  "startY": 260,
  "horizontalSpacing": 55,
  "verticalSpacing": 55,
  "unavailablePositions": [
    {
      "rowNumber": 2,
      "columnNumber": 8
    }
  ],
  "accessiblePositions": [
    {
      "rowNumber": 1,
      "columnNumber": 1
    }
  ],
  "gaps": [
    {
      "rowNumber": 1,
      "startColumn": 5,
      "columnSpan": 1
    }
  ]
}


### 5 - Organizer preview
GET {{baseUrl}}/api/events/{{eventId}}/seating-layout/organizer
X-SEVPMS-Demo-UserId: {{organizerId}}
X-SEVPMS-Demo-Role: Organizer


### 6 - Publish layout
PUT {{baseUrl}}/api/events/{{eventId}}/seating-layout/publish
Content-Type: application/json
X-SEVPMS-Demo-UserId: {{organizerId}}
X-SEVPMS-Demo-Role: Organizer

{
  "publish": true
}


### 7 - Customer sees only published layout
GET {{baseUrl}}/api/events/{{eventId}}/seating-layout/published


### 8 - Check live seat availability
GET {{baseUrl}}/api/events/{{eventId}}/seats


### 9 - Customer holds a seat
POST {{baseUrl}}/api/events/{{eventId}}/seat-holds
Content-Type: application/json
X-SEVPMS-Demo-UserId: {{customerId}}
X-SEVPMS-Demo-Role: Customer

{
  "seatIds": [
    "{{seatId}}"
  ],
  "holdToken": null
}


### 10 - View 360 panorama for selected seat
GET {{baseUrl}}/api/events/{{eventId}}/seats/{{seatId}}/view


### 11 - Re-check availability; selected seat should be Held
GET {{baseUrl}}/api/events/{{eventId}}/seats


### 12 - Organizer/admin recovery commit of hold to booking
POST {{baseUrl}}/api/seat-holds/{{holdToken}}/commit?bookingId={{bookingId}}&customerUserId={{customerId}}
X-SEVPMS-Demo-UserId: {{organizerId}}
X-SEVPMS-Demo-Role: Organizer


### 13 - Issue ticket after verified booking/payment
POST {{baseUrl}}/api/bookings/{{bookingId}}/tickets/issue
Content-Type: application/json
X-SEVPMS-Demo-UserId: {{organizerId}}
X-SEVPMS-Demo-Role: Organizer

{
  "eventId": "{{eventId}}",
  "seatIds": [
    "{{seatId}}"
  ]
}


### 14 - Get booking tickets
GET {{baseUrl}}/api/bookings/{{bookingId}}/tickets
X-SEVPMS-Demo-UserId: {{customerId}}
X-SEVPMS-Demo-Role: Customer


### 15 - Read ticket by ticket number
GET {{baseUrl}}/api/tickets/{{ticketNo}}
X-SEVPMS-Demo-UserId: {{customerId}}
X-SEVPMS-Demo-Role: Customer


### 16 - First QR check-in should be Accepted
POST {{baseUrl}}/api/events/{{eventId}}/check-ins/scan
Content-Type: application/json
X-SEVPMS-Demo-UserId: {{scannerId}}
X-SEVPMS-Demo-Role: Organizer

{
  "qrPayload": "{{qrPayload}}",
  "gate": "Gate 1"
}


### 17 - Scan same QR again; should return Duplicate
POST {{baseUrl}}/api/events/{{eventId}}/check-ins/scan
Content-Type: application/json
X-SEVPMS-Demo-UserId: {{scannerId}}
X-SEVPMS-Demo-Role: Organizer

{
  "qrPayload": "{{qrPayload}}",
  "gate": "Gate 1"
}
